                        <div class="exp-row">
                            <label for="inputClienteExp">CLIENTE</label>
                            <input type="text" id="inputClienteExp" class="input-flex">
                        </div>

                        <div class="exp-row">
                            <label for="inputLacreExp">LACRE</label>
                            <input type="text" id="inputLacreExp" class="input-short">
                            <button type="button" class="btn-fechar-exp" id="btnFecharExp" style="margin-left: 20px;">FECHAR</button>
                        </div>
                    </div>

                    <div class="exp-bottom-section">
                        <div class="etiqueta-cd-box">
                            <div class="etiqueta-header">CD/RJ</div>
                            <div class="etiqueta-grid">
                                <div class="etiqueta-field">
                                    <label for="lblDataCd">DATA</label>
                                    <input type="text" id="lblDataCd" readonly>
                                </div>
                                <div class="etiqueta-field">
                                    <label for="lblVolCd">VOL</label>
                                    <input type="text" id="lblVolCd" readonly>
                                </div>
                                <div class="etiqueta-field full-width">
                                    <label for="lblClienteCd">CLIENTE</label>
                                    <input type="text" id="lblClienteCd" readonly>
                                </div>
                                <div class="etiqueta-field">
                                    <label for="lblLacreCd">LACRE</label>
                                    <input type="text" id="lblLacreCd" readonly>
                                </div>
                                <div class="etiqueta-field">
                                    <label for="lblCamCd">CAM</label>
                                    <input type="text" id="lblCamCd" readonly>
                                </div>
                            </div>
                            <div class="etiqueta-colaborador">
                                COLABORADOR: <span id="valColaboradorCd">--</span>
                            </div>
                        </div>

                        <div class="exp-actions-btns">
                            <button type="button" class="btn-exp-action btn-imprimir" id="btnImprimir">IMPRIMIR</button>
                            <button type="button" class="btn-exp-action btn-reimprimir" id="btnReimprimir">REIMPRIMIR</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // --- BASE DE DADOS LOCAL ---
        function obterUsuarios() {
            const users = localStorage.getItem('prov_users');
            if (users) {
                return JSON.parse(users);
            } else {
                // Usuário default de teste inicial
                const defaultUsers = {
                    "1234": {
                        nome: "ADMINISTRADOR",
                        cargo: "AUXILIAR DE LOGÍSTICA 3",
                        senha: "1234"
                    }
                };
                localStorage.setItem('prov_users', JSON.stringify(defaultUsers));
                return defaultUsers;
            }
        }

        function salvarUsuarios(usuarios) {
            localStorage.setItem('prov_users', JSON.stringify(usuarios));
        }

        // --- ELEMENTOS DO DOM ---
        // Topbar e Perfil
        const topbar = document.getElementById('topbar');
        const userAvatar = document.getElementById('userAvatar');
        const userNameDisplay = document.getElementById('userNameDisplay');
        const userRoleDisplay = document.getElementById('userRoleDisplay');
        const btnLogout = document.getElementById('btnLogout');

        // Sidebar
        const sidebarLogo = document.getElementById('sidebarLogo');
        const sidebarMenu = document.getElementById('sidebarMenu');
        const linkUpload = document.getElementById('linkUpload');
        const linkEstoque = document.getElementById('linkEstoque');
        const linkSeparacao = document.getElementById('linkSeparacao');
        const submenuSeparacao = document.getElementById('submenuSeparacao');
        const subFilaTrabalho = document.getElementById('subFilaTrabalho');
        const subListaSeparacao = document.getElementById('subListaSeparacao');
        const linkConferencao = document.getElementById('linkConferencao');
        const linkExpedicao = document.getElementById('linkExpedicao');

        // Telas
        const screenLogin = document.getElementById('screenLogin');
        const screenRecovery = document.getElementById('screenRecovery');
        const screenRegister = document.getElementById('screenRegister');
        const screenMenu = document.getElementById('screenMenu');
        const screenUpload = document.getElementById('screenUpload');
        const screenEstoque = document.getElementById('screenEstoque');
        const screenFilaTrabalho = document.getElementById('screenFilaTrabalho');
        const screenListaSeparacao = document.getElementById('screenListaSeparacao');
        const screenConferencao = document.getElementById('screenConferencao');
        const screenExpedicao = document.getElementById('screenExpedicao');

        // Formulários de Autenticação
        const txtUsuario = document.getElementById('txtUsuario');
        const txtSenha = document.getElementById('txtSenha');
        const btnLogar = document.getElementById('btnLogar');

        const txtRecMatricula = document.getElementById('txtRecMatricula');
        const txtNovaSenha = document.getElementById('txtNovaSenha');
        const btnRedefinirSenha = document.getElementById('btnRedefinirSenha');

        const txtRegMatricula = document.getElementById('txtRegMatricula');
        const txtRegNome = document.getElementById('txtRegNome');
        const txtRegCargo = document.getElementById('txtRegCargo');
        const txtRegSenha = document.getElementById('txtRegSenha');
        const btnCadastrar = document.getElementById('btnCadastrar');

        // Links de Transição de Autenticação
        const linkGoRecovery = document.getElementById('linkGoRecovery');
        const linkGoRegister = document.getElementById('linkGoRegister');
        const linkBackLoginRec = document.getElementById('linkBackLoginRec');
        const linkBackLoginReg = document.getElementById('linkBackLoginReg');

        // Função utilitária para esconder todas as telas
        function hideAllScreens() {
            screenLogin.classList.add('hidden');
            screenRecovery.classList.add('hidden');
            screenRegister.classList.add('hidden');
            screenMenu.classList.add('hidden');
            screenUpload.classList.add('hidden');
            screenEstoque.classList.add('hidden');
            screenFilaTrabalho.classList.add('hidden');
            screenListaSeparacao.classList.add('hidden');
            screenConferencao.classList.add('hidden');
            screenExpedicao.classList.add('hidden');
        }

        // --- AÇÕES DE NAVEGAÇÃO DE AUTENTICAÇÃO ---
        linkGoRecovery.addEventListener('click', () => {
            hideAllScreens();
            screenRecovery.classList.remove('hidden');
        });

        linkGoRegister.addEventListener('click', () => {
            hideAllScreens();
            screenRegister.classList.remove('hidden');
        });

        linkBackLoginRec.addEventListener('click', () => {
            hideAllScreens();
            screenLogin.classList.remove('hidden');
        });

        linkBackLoginReg.addEventListener('click', () => {
            hideAllScreens();
            screenLogin.classList.remove('hidden');
        });

        // --- LÓGICA DE LOGIN ---
        btnLogar.addEventListener('click', () => {
            const matricula = txtUsuario.value.trim();
            const senha = txtSenha.value.trim();

            if (!matricula || !senha) {
                alert('Por favor, preencha a matrícula e a senha!');
                return;
            }

            const usuarios = obterUsuarios();

            if (usuarios[matricula] && usuarios[matricula].senha === senha) {
                const user = usuarios[matricula];
                
                // Preenche os dados do perfil logado
                userNameDisplay.textContent = user.nome.toUpperCase();
                userRoleDisplay.textContent = user.cargo.toUpperCase();
                userAvatar.textContent = user.nome.charAt(0).toUpperCase();

                hideAllScreens();
                screenMenu.classList.remove('hidden');
                sidebarLogo.classList.remove('hidden');
                sidebarMenu.classList.remove('hidden');
                topbar.classList.remove('hidden');

                txtSenha.value = '';
            } else {
                alert('Matrícula ou senha incorretos!');
            }
        });

        // --- LÓGICA DE CADASTRO ---
        btnCadastrar.addEventListener('click', () => {
            const matricula = txtRegMatricula.value.trim();
            const nome = txtRegNome.value.trim();
            const cargo = txtRegCargo.value.trim();
            const senha = txtRegSenha.value.trim();

            if (!matricula || !nome || !cargo || !senha) {
                alert('Por favor, preencha todos os campos do cadastro!');
                return;
            }

            const usuarios = obterUsuarios();

            if (usuarios[matricula]) {
                alert('Esta matrícula já está cadastrada no sistema!');
                return;
            }

            usuarios[matricula] = {
                nome: nome,
                cargo: cargo,
                senha: senha
            };

            salvarUsuarios(usuarios);
            alert('Usuário cadastrado com sucesso! Faça login para continuar.');

            // Limpa campos e volta para login
            txtRegMatricula.value = '';
            txtRegNome.value = '';
            txtRegCargo.value = '';
            txtRegSenha.value = '';

            hideAllScreens();
            screenLogin.classList.remove('hidden');
        });

        // --- LÓGICA DE RECUPERAÇÃO / REDEFINIÇÃO DE SENHA ---
        btnRedefinirSenha.addEventListener('click', () => {
            const matricula = txtRecMatricula.value.trim();
            const novaSenha = txtNovaSenha.value.trim();

            if (!matricula || !novaSenha) {
                alert('Informe a matrícula e a nova senha!');
                return;
            }

            const usuarios = obterUsuarios();

            if (!usuarios[matricula]) {
                alert('Matrícula não localizada no sistema!');
                return;
            }

            usuarios[matricula].senha = novaSenha;
            salvarUsuarios(usuarios);

            alert('Senha redefinida com sucesso! Redirecionando para o login.');

            txtRecMatricula.value = '';
            txtNovaSenha.value = '';

            hideAllScreens();
            screenLogin.classList.remove('hidden');
        });

        // --- LOGOUT ---
        btnLogout.addEventListener('click', () => {
            hideAllScreens();
            screenLogin.classList.remove('hidden');
            sidebarLogo.classList.add('hidden');
            sidebarMenu.classList.add('hidden');
            topbar.classList.add('hidden');
            submenuSeparacao.classList.add('hidden');
            txtUsuario.value = '';
            txtSenha.value = '';
        });

        // --- NAVEGAÇÃO DO MENU LATERAL ---
        linkUpload.addEventListener('click', () => { hideAllScreens(); screenUpload.classList.remove('hidden'); });
        linkEstoque.addEventListener('click', () => { hideAllScreens(); screenEstoque.classList.remove('hidden'); });
        linkSeparacao.addEventListener('click', () => { submenuSeparacao.classList.toggle('hidden'); });
        subFilaTrabalho.addEventListener('click', () => { hideAllScreens(); screenFilaTrabalho.classList.remove('hidden'); });
        subListaSeparacao.addEventListener('click', () => { hideAllScreens(); screenListaSeparacao.classList.remove('hidden'); });
        linkConferencao.addEventListener('click', () => { hideAllScreens(); screenConferencao.classList.remove('hidden'); });
        linkExpedicao.addEventListener('click', () => { hideAllScreens(); screenExpedicao.classList.remove('hidden'); });
        sidebarLogo.addEventListener('click', () => { hideAllScreens(); screenMenu.classList.remove('hidden'); });

        // Inicializador
        obterUsuarios();
    </script>

</body>
</html>